# ═══════════════════════════════════════════════════════════════════
#  CHECKOUT API — .env.example
#  Copie este ficheiro: copy .env.example .env
#  Depois preencha cada variável conforme as instruções abaixo
# ═══════════════════════════════════════════════════════════════════


# ────────────────────────────────────────────────────────────────────
# APP
# ────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001


# ────────────────────────────────────────────────────────────────────
# SUPABASE — BASE DE DADOS POSTGRESQL
#
# COMO OBTER:
#   1. Vai a https://supabase.com/dashboard/project/pwhpahcwbtmvzaqtscsn
#   2. No menu lateral: Settings → Database
#   3. Clica em "Connection String"
#   4. Escolhe o separador "Transaction pooler" → copia para DATABASE_URL
#   5. Escolhe o separador "Direct connection" → copia para DIRECT_URL
#   6. Substitui [YOUR-PASSWORD] pela password da base de dados
#      (é a password que definiste ao criar o projeto Supabase)
#
# NOTA: As duas URLs têm portas diferentes:
#   DATABASE_URL  → porta 6543  (para queries normais / pooler)
#   DIRECT_URL    → porta 5432  (para migrations / prisma push)
# ────────────────────────────────────────────────────────────────────

DATABASE_URL="postgresql://postgres.pwhpahcwbtmvzaqtscsn:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.pwhpahcwbtmvzaqtscsn:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"


# ────────────────────────────────────────────────────────────────────
# JWT — AUTENTICAÇÃO DO PAINEL ADMIN
#
# COMO GERAR UM SECRET SEGURO:
#   Corre este comando no terminal:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   Cola o resultado abaixo.
# ────────────────────────────────────────────────────────────────────

JWT_SECRET="COLA_AQUI_O_RESULTADO_DO_COMANDO_ACIMA"
JWT_EXPIRES_IN="7d"


# ────────────────────────────────────────────────────────────────────
# VOUCHER ENCRYPTION KEY — CHAVE DE ENCRIPTAÇÃO AES-256
#
# COMO GERAR:
#   Corre este comando no terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   O resultado é uma string de 64 caracteres hexadecimais.
#   Cola o resultado abaixo.
#
# ATENÇÃO: Guarda esta chave num lugar seguro (ex: password manager).
#   Se a perderes, não consegues decifrar os vouchers guardados.
# ────────────────────────────────────────────────────────────────────

VOUCHER_ENCRYPTION_KEY="COLA_AQUI_64_CARACTERES_HEX"


# ────────────────────────────────────────────────────────────────────
# CRYPTOMUS — PAGAMENTOS CRYPTO
#
# COMO OBTER (depois de criar a conta):
#   1. Vai a https://app.cryptomus.com
#   2. Menu: Merchants → o teu merchant → Settings → API
#   3. Copia o "Merchant UUID" → CRYPTOMUS_MERCHANT_ID
#   4. Copia o "Payment API key" → CRYPTOMUS_PAYMENT_API_KEY
#
# NOTA: Deixa vazio por agora se ainda não tens conta.
#   O sistema funciona sem crypto — usa só vouchers.
# ────────────────────────────────────────────────────────────────────

CRYPTOMUS_MERCHANT_ID=""
CRYPTOMUS_PAYMENT_API_KEY=""


# ────────────────────────────────────────────────────────────────────
# CORS — ORIGENS PERMITIDAS
#
# Lista de URLs do frontend separadas por vírgula.
# Em desenvolvimento: http://localhost:5173 (Vite)
# Em produção: adiciona o teu domínio real
# ────────────────────────────────────────────────────────────────────

CORS_ORIGINS="http://localhost:5173"


# ════════════════════════════════════════════════════════════════════
#  DEPOIS DE PREENCHER O .env, CORRE EM SEQUÊNCIA:
#
#  1. npx prisma db push        ← cria as tabelas no Supabase
#  2. npm run start:dev         ← arranca o servidor na porta 3001
#
#  API disponível em: http://localhost:3001/api/v1
# ════════════════════════════════════════════════════════════════════
